# CloudOps AI Agent — backend configuration
# Copy to .env and adjust. All variables are optional; defaults run demo mode.

# --- Modes -------------------------------------------------------------------
CLOUDOPS_DEMO_MODE=true

# Live read-only providers (fail closed without allowlists + credentials)
CLOUDOPS_GCP_ENABLED=false
CLOUDOPS_GCP_ALLOWED_PROJECTS=            # e.g. my-project-id (comma-separated)
CLOUDOPS_AWS_ENABLED=false
CLOUDOPS_AWS_ALLOWED_ACCOUNTS=            # e.g. 123456789012 (comma-separated)
CLOUDOPS_AWS_REGION=us-east-1

# --- LLM ---------------------------------------------------------------------
# "mock" = deterministic, no key needed. "gemini" requires an API key.
CLOUDOPS_LLM_PROVIDER=mock
CLOUDOPS_GEMINI_API_KEY=
# Verify the model is available to your key before enabling:
CLOUDOPS_GEMINI_MODEL=gemini-2.5-flash

# --- Agent limits --------------------------------------------------------------
CLOUDOPS_MAX_STEPS=8
CLOUDOPS_TOOL_TIMEOUT_SECONDS=20
CLOUDOPS_INVESTIGATION_TIMEOUT_SECONDS=120

# --- HTTP / security -----------------------------------------------------------
CLOUDOPS_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
CLOUDOPS_RATE_LIMIT_PER_MINUTE=240
CLOUDOPS_INVESTIGATIONS_RATE_LIMIT_PER_MINUTE=12

# --- Persistence ---------------------------------------------------------------
# CLOUDOPS_DB_PATH=./data/cloudops.db
